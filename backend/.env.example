# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000
SECRET_KEY=change-this-in-production

# CORS Configuration
# Comma-separated allowed origins or * for local development
CORS_ORIGINS=*

# MySQL Database Configuration
# Host: 127.0.0.1
# Port: 3306
# Username: travel_app
# Database: smart_travel_db
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=travel_app
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=smart_travel_db

# Provider Architecture Configuration (Step 9)
# Demo provider is enabled by default
DEMO_PROVIDER_ENABLED=true

# Future live providers remain strictly disabled by default
VIATOR_ENABLED=false
VIATOR_API_KEY=

BOOKING_ENABLED=false
BOOKING_API_KEY=
BOOKING_AFFILIATE_ID=
